{
  "name": "@zod-codepen/core",
  "version": "1.0.1",
  "description": "Core serialization logic for zod-to-code",
  "keywords": [
    "zod",
    "schema",
    "serialization",
    "code-generation",
    "typescript"
  ],
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/babel__traverse": "^7.28.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.51.0"
  },
  "peerDependencies": {
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5"
  }
}
